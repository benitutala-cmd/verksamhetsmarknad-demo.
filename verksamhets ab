}

function esc(value){
  return String(value??"").replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",
    '"':"&quot;","'":"&#39;"
  }[c]));
}

function money(n){
  return new Intl.NumberFormat("sv-SE",{
    style:"currency",currency:"SEK",maximumFractionDigits:0
  }).format(n||0);
}

function dateText(n){
  return new Date(n).toLocaleString("sv-SE",{
    dateStyle:"medium",timeStyle:"short"
  });
}

function localDateValue(timestamp){
  if(!timestamp)return "";
  const d=new Date(timestamp);
  return new Date(timestamp-d.getTimezoneOffset()*60000)
    .toISOString().slice(0,16);
}

function countdown(end){
  const s=Math.max(0,Math.floor((end-Date.now())/1000));
  const d=Math.floor(s/86400);
  const h=Math.floor((s%86400)/3600);
  const m=Math.floor((s%3600)/60);
  const sec=s%60;
  if(d)return `${d} dagar ${h} tim ${m} min`;
  return [h,m,sec].map(x=>String(x).padStart(2,"0")).join(":");
}

function statusOf(item){
  if(!item.auction)return "ordinary";
  if(Date.now()<item.start)return "upcoming";
  if(Date.now()>=item.end)return "ended";
  return "live";
}

function highestBid(item){
  return Math.max(item.price,...(item.bids||[]).map(x=>x.amount));
}

function findItem(id){
  return state.listings.find(x=>x.id===id);
}

function validImage(url){
  try{
    const parsed=new URL(url);
    return ["https:","http:"].includes(parsed.protocol)
      ?parsed.href:imageLibrary.property;
  }catch(error){
    return imageLibrary.property;
  }
}

function go(page){
  currentPage=page;
  render();
  window.scrollTo(0,0);
}

function newListing(){
  editingId=null;
  go("sell");
