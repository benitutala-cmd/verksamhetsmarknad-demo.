function refreshAuctionStatuses(){
  const statuses=state.listings
    .filter(x=>x.auction)
    .map(x=>x.id+":"+statusOf(x))
    .join("|");

  if(lastAuctionStatuses!==statuses){
    lastAuctionStatuses=statuses;

    if(["home","live","detail","explore"].includes(currentPage)){
      render();
    }
  }

  document.querySelectorAll("[data-countdown]").forEach(element=>{
    const item=findItem(element.dataset.countdown);
    if(item&&statusOf(item)==="live"){
      element.textContent=countdown(item.end);
    }
  });
}

