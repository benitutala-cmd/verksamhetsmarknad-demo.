function toggleFavorite(id){
  if(state.favorites.includes(id)){
    state.favorites=state.favorites.filter(x=>x!==id);
  }else{
    state.favorites.push(id);
  }
  save();
  render();
}

/* ====================================
   4. ANNONS-KORT
==================================== */

function card(item){
  const status=statusOf(item);
  const label={
    live:'<span class="badge live">● LIVE · DEMO</span>',
    upcoming:'<span class="badge">Kommande auktion</span>',
    ended:'<span class="badge">Avslutad auktion</span>',
    ordinary:'<span class="badge green">Till salu</span>'
  }[status];

  return `
  <article class="card">
    <img src="${esc(validImage(item.image))}"
         alt="Illustrationsbild för ${esc(item.title)}"
         loading="lazy">
    <div class="card-body">
      <div class="row between">
        ${label}
        <button class="btn secondary small"
          onclick="toggleFavorite('${item.id}')"
          aria-label="Spara annons">
          ${state.favorites.includes(item.id)?"♥":"♡"}
        </button>
      </div>
      <h3>${esc(item.title)}</h3>
      <p class="muted small">
        ${esc(item.city)} · ${esc(item.category)}
      </p>
      <div class="price">
        ${money(item.auction?highestBid(item):item.price)}
      </div>
      <p class="small muted">
        ${item.auction?"Demobud / utgångspris":"Begärt pris"}
      </p>
      ${status==="live"
        ?`<p class="small">⏱ <span data-countdown="${item.id}">${countdown(item.end)}</span> kvar</p>`
        :status==="upcoming"
        ?`<p class="small">Start: ${dateText(item.start)}</p>`
        :""}
      <button class="btn" onclick="openItem('${item.id}')">
        ${item.auction?"Visa auktion":"Visa företag"}
      </button>
    </div>
  </article>`;
}

