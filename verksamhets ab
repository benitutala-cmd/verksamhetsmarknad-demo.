function applyAuction(id){
  const item=findItem(id);
  if(!item||statusOf(item)==="ended")return;

  if(!confirm(
    "DEMO: Vill du bli automatiskt godkänd som testbudgivare?"
  ))return;

  state.applications[id]="approved";
  save();
  render();
}

function placeBid(id){
  const item=findItem(id);
  if(!item||statusOf(item)!=="live")return;
  if(state.applications[id]!=="approved")return;

  const input=document.getElementById("bidInput");
  const amount=Number(input?.value);
  const minimum=highestBid(item)+(item.step||1000);

  if(!Number.isSafeInteger(amount)||amount<minimum){
    alert("Minsta demobud är "+money(minimum));
    return;
  }

  if(!confirm("Bekräfta demobud på "+money(amount)+"?"))return;

  item.bids.push({
    name:state.profile.name+" (testbud)",
    amount,
    at:Date.now()
  });

  save();
  render();
}

function contactSeller(){
  alert(
    "Detta är en demo. I den riktiga versionen "+
    "kommer du kunna kontakta säljaren direkt."
