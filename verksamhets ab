function saveListing(event){
  event.preventDefault();

  const data=new FormData(event.target);
  const auction=data.get("mode")==="auction";
  const plan=String(data.get("plan"));
  const price=Number(data.get("price"));
  const step=Number(data.get("step"));
  const start=new Date(data.get("start")).getTime();
  const end=new Date(data.get("end")).getTime();

  if(!Number.isSafeInteger(price)||price<=0){
    alert("Ange ett giltigt pris.");
    return;
  }

  if(auction&&!["gold","ultimate"].includes(plan)){
    alert("Välj Gold eller Ultimate för LIVE-auktion.");
    return;
  }

  if(auction&&(
    !Number.isFinite(start)||
    !Number.isFinite(end)||
    end<=start||
    end<=Date.now()||
    !Number.isSafeInteger(step)||
    step<100
  )){
    alert("Kontrollera auktionens tider och budsteg.");
    return;
  }

  const old=editingId?findItem(editingId):null;

  if(old?.bids?.length&&(
    old.price!==price||
    old.auction!==auction||
    old.start!==(auction?start:null)||
    old.end!==(auction?end:null)||
    old.step!==(auction?step:0)
  )){
    alert(
      "Pris och auktionsvillkor kan inte ändras "+
      "efter att demobud har lagts."
    );
    return;
  }

  const item={
    id:old?.id||"user_"+Date.now(),
    owner:"me",
    title:String(data.get("title")).trim(),
    category:String(data.get("category")).trim(),
    city:String(data.get("city")).trim(),
    price,
    description:String(data.get("description")).trim(),
    image:String(data.get("image")).trim()||imageLibrary.property,
    plan,
    auction,
    start:auction?start:null,
    end:auction?end:null,
    step:auction?step:0,
    bids:old?.bids||[]
  };

  if(old){
    state.listings=state.listings.map(x=>x.id===old.id?item:x);
  }else{
    state.listings.unshift(item);
  }

  editingId=null;
  save();
  openItem(item.id);
}

