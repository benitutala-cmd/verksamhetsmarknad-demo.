let currentPage="home";
let selectedId=null;
let editingId=null;
let liveFilter="all";
let searchText="";
let lastAuctionStatuses="";

function save(){
  try{
    localStorage.setItem(STORAGE_KEY,JSON.stringify(state));
  }catch(error){
    console.warn("Kunde inte spara:",error);
    alert("Lagringsutrymmet räcker inte. Prova en mindre profilbild.");
