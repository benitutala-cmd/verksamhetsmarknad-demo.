/* ====================================
   3. SPARAD DATA OCH SÄKER HANTERING
==================================== */

function initialState(){
  return {
    listings:JSON.parse(JSON.stringify(demoBusinesses)),
    profile:{name:"Demoanvändare",image:""},
    applications:{},
    favorites:[],
    lessons:[],
    npcEnabled:true
  };
}

function loadState(){
  const defaults=initialState();
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    const saved=raw?JSON.parse(raw):null;

    if(saved && Array.isArray(saved.listings)){
      return {
        ...defaults,
        ...saved,
        profile:{...defaults.profile,...(saved.profile||{})},
        applications:saved.applications||{},
        favorites:Array.isArray(saved.favorites)?saved.favorites:[],
        lessons:Array.isArray(saved.lessons)?saved.lessons:[]
      };
    }
  }catch(error){
    console.warn("Kunde inte läsa demodata:",error);
  }
  return defaults;
}

