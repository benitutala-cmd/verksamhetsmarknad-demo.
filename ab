setInterval(()=>{
  const countdown=document.getElementById("countdown");
  if(countdown) {
    const item=findListing(selectedListing);
    if(item && item.auction) {
      if(statusOf(item)==="ended") render();
      else countdown.textContent=remaining(item.end);
    }
  }
},1000);

