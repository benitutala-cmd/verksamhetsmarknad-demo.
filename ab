          ${listingCard(item)}
          <div class="row" style="margin-top:10px">
            <button class="btn secondary"
              onclick="editListing('${item.id}')">Redigera</button>
            <button class="btn red"
              onclick="deleteListing('${item.id}')">Ta bort</button>
