function saveProfile() {
  const name=document.getElementById("profileName").value.trim();
  state.profile.name=name||"Demoanvändare";

  const file=document.getElementById("profileImage").files[0];

  if(!file) {
    save();
    render();
    return;
  }

  if(!["image/jpeg","image/png","image/webp"].includes(file.type)
     ||file.size>1024*1024) {
    alert("Välj JPG, PNG eller WebP under 1 MB.");
    return;
  }

  const reader=new FileReader();
  reader.onload=function() {
    state.profile.image=String(reader.result);
    save();
    render();
  };
  reader.readAsDataURL(file);
}

function removeProfileImage() {
  state.profile.image="";
  save();
  render();
}

function setNPC(value) {
  state.npcEnabled=value;
  save();
}

function editListing(id) {
  const item=findListing(id);
  if(!item || item.owner!=="me") return;
  editingId=id;
  showPage("sell");
}

function deleteListing(id) {
  const item=findListing(id);
  if(!item || item.owner!=="me") return;
  if(!confirm("Vill du ta bort din demoannons?")) return;

  state.listings=state.listings.filter(x=>x.id!==id);
  state.favorites=state.favorites.filter(x=>x!==id);
  delete state.applications[id];

  save();
  render();
}

function resetDemo() {
  if(!confirm("Återställa alla lokala demoändringar?")) return;
  localStorage.removeItem(STORAGE_KEY);
  state=initialState();
  editingId=null;
  showPage("home");
}

/* =====================================
   13. SIDHANTERING
   ===================================== */

function render() {
  const app=document.getElementById("app");

  switch(currentPage) {
    case "home":app.innerHTML=homePage();break;
    case "explore":app.innerHTML=explorePage();break;
    case "live":app.innerHTML=livePage();break;
    case "detail":app.innerHTML=detailPage();break;
    case "sell":
      app.innerHTML=sellPage();
      toggleAuctionFields();
      break;
    case "academy":app.innerHTML=academyPage();break;
    case "plans":app.innerHTML=plansPage();break;
    case "account":app.innerHTML=accountPage();break;
    default:app.innerHTML=homePage();
  }
}

